{
  "name": "snarkjs",
  "type": "module",
  "version": "0.7.6",
  "description": "zkSNARKs implementation in JavaScript",
  "main": "./build/main.cjs",
  "module": "./main.js",
  "exports": {
    ".": {
      "node": {
        "import": "./main.js",
        "require": "./build/main.cjs"
      },
      "browser": "./build/browser.esm.js",
      "umd": "./build/snarkjs.min.js"
    }
  },
  "files": [
    "COPYING",
    "README.md",
    "build/",
    "cli.js",
    "main.js",
    "src/",
    "templates/"
  ],
  "scripts": {
    "lint": "eslint .",
    "clean": "node -e \"fs.rmSync('build',{recursive:true,force:true})\"",
    "test": "npm run build:node && npm run build:browser && npm run lint && vitest run",
    "test:node": "vitest run --project node-esm",
    "test:watch": "vitest --project node-esm",
    "build:node": "vite build",
    "build:cli": "vite build --mode cli",
    "build:browser": "vite build --mode browser",
    "build:iife": "vite build --mode browser-iife",
    "build": "npm run clean && npm run build:node && npm run build:cli && npm run build:browser && npm run build:iife",
    "test:browser": "vitest run --project browser-chromium"
  },
  "bin": {
    "snarkjs": "build/cli.cjs"
  },
  "directories": {
    "templates": "templates"
  },
  "keywords": [
    "zksnark",
    "zcash",
    "ethereum",
    "zero",
    "knowledge",
    "cryptography",
    "circuit"
  ],
  "author": "Jordi Baylina",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iden3/snarkjs.git"
  },
  "dependencies": {
    "@iden3/binfileutils": "git+https://github.com/iden3/binfileutils.git#34eb6c3db112a8d20aa3ee968445a026478f7040",
    "@noble/hashes": "2.2.0",
    "circom_runtime": "0.1.28",
    "fastfile": "git+https://github.com/iden3/fastfile.git#07ea279c676de9ec7f19929ab1215d2c18da838b",
    "ffjavascript": "git+https://github.com/iden3/ffjavascript.git#27a93c3f382845b573b66f9eb52cd3f6ff41dffb",
    "r1csfile": "git+https://github.com/iden3/r1csfile.git#7bada7e395d70c229ff6741cc8a814fb8f89a9f6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "playwright": "^1.59.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "postcss": "^8.5.26",
    "brace-expansion": "^5.0.9"
  }
}
