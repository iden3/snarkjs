{
  "name": "snarkjs",
  "type": "module",
  "version": "0.7.6",
  "description": "zkSNARKs implementation in JavaScript",
  "main": "./build/main.cjs",
  "module": "./main.js",
  "exports": {
    ".": {
      "node": {
        "import": "./main.js",
        "require": "./build/main.cjs"
      },
      "browser": "./build/browser.esm.js",
      "umd": "./build/snarkjs.min.js"
    }
  },
  "files": [
    "COPYING",
    "README.md",
    "build/",
    "cli.js",
    "main.js",
    "src/",
    "templates/"
  ],
  "scripts": {
    "lint": "eslint .",
    "clean": "rimraf build",
    "pretest": "npm run build:node && npm run build:browser && npm run lint",
    "test": "vitest run",
    "test:node": "vitest run --project node-esm",
    "test:watch": "vitest --project node-esm",
    "build:node": "vite build",
    "build:cli": "vite build --mode cli",
    "build:browser": "vite build --mode browser",
    "build:iife": "vite build --mode browser-iife",
    "build": "npm run clean && npm run build:node && npm run build:cli && npm run build:browser && npm run build:iife",
    "test:browser": "vitest run --project browser-chromium"
  },
  "bin": {
    "snarkjs": "build/cli.cjs"
  },
  "directories": {
    "templates": "templates"
  },
  "keywords": [
    "zksnark",
    "zcash",
    "ethereum",
    "zero",
    "knowledge",
    "cryptography",
    "circuit"
  ],
  "author": "Jordi Baylina",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iden3/snarkjs.git"
  },
  "dependencies": {
    "@iden3/binfileutils": "git+https://github.com/iden3/binfileutils.git#c69440f3da151732aeb823a95277762828803eb3",
    "@noble/hashes": "^2.2.0",
    "bfj": "^9.1.3",
    "circom_runtime": "0.1.28",
    "ejs": "^6.0.1",
    "fastfile": "git+https://github.com/iden3/fastfile.git#ad59e79d25665c55514975c5e6626311e8088b12",
    "ffjavascript": "git+https://github.com/iden3/ffjavascript.git#76fc09aad04ef472a70405474ea537daa6800b16",
    "logplease": "^1.2.15",
    "r1csfile": "git+https://github.com/iden3/r1csfile.git#bf6933bba390533d1cfd965d9c06da95d74420b9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "playwright": "^1.59.0",
    "rimraf": "^6.1.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "postcss": "^8.5.26",
    "brace-expansion": "^5.0.9"
  }
}
