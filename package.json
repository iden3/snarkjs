{
  "name": "snarkjs",
  "type": "module",
  "version": "0.7.6-poc",
  "description": "zkSNARKs implementation in JavaScript",
  "main": "./build/main.cjs",
  "module": "./main.js",
  "exports": {
    ".": {
      "node": {
        "import": "./main.js",
        "require": "./build/main.cjs"
      },
      "browser": "./build/browser.esm.js",
      "default": "./main.js"
    }
  },
  "files": [
    "COPYING",
    "README.md",
    "build/",
    "cli.js",
    "main.js",
    "src/",
    "templates/"
  ],
  "scripts": {
    "lint": "eslint .",
    "clean": "rimraf build",
    "pretest": "npm run build:node && npm run build:browser && npm run lint",
    "test": "vitest run",
    "test:node": "vitest run --project node-esm",
    "test:watch": "vitest --project node-esm",
    "build:node": "vite build",
    "build:cli": "vite build --mode cli",
    "build:browser": "vite build --mode browser",
    "build:iife": "vite build --mode browser-iife",
    "build": "npm run clean && npm run build:node && npm run build:cli && npm run build:browser && npm run build:iife"
  },
  "bin": {
    "snarkjs": "build/cli.cjs"
  },
  "directories": {
    "templates": "templates"
  },
  "keywords": [
    "zksnark",
    "zcash",
    "ethereum",
    "zero",
    "knowledge",
    "cryptography",
    "circuit"
  ],
  "author": "Jordi Baylina",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iden3/snarkjs.git"
  },
  "dependencies": {
    "@iden3/binfileutils": "https://github.com/iden3/binfileutils.git#feat/esm-migration",
    "@noble/hashes": "^2.0.1",
    "circom_runtime": "0.1.28",
    "ejs": "^5.0.1",
    "fastfile": "https://github.com/iden3/fastfile.git#feat/esm-migration",
    "ffjavascript": "https://github.com/iden3/ffjavascript.git#feat/esm-migration",
    "logplease": "^1.2.15",
    "r1csfile": "https://github.com/iden3/r1csfile.git#feat/esm-migration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-ethers": "^4.0.7",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "bfj": "^9.1.3",
    "eslint": "^10.1.0",
    "ethers": "^6.13.5",
    "globals": "^17.4.0",
    "hardhat": "^3.3.0",
    "playwright": "^1.59.0",
    "rimraf": "^6.1.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
