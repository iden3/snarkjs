# Supply-chain hardening.
#
# ignore-scripts: no dependency may run code at install time. The whole tree
# is currently verified script-free (npm query ":attr(scripts,[postinstall])"
# is empty), so this costs nothing today and turns a future dep adding a
# postinstall into an explicit, reviewed decision instead of silent code
# execution. Note: this also disables package.json pre/post hooks, so the
# test script chains its build and lint steps explicitly.
#
# save-exact: npm install --save records exact versions, not ^ranges.
ignore-scripts=true
save-exact=true
